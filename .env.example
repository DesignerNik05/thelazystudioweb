# Contact form — set these in Vercel (Project → Settings → Environment Variables).
# Never commit real values; .env* is gitignored.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where website enquiries are delivered.
CONTACT_TO=hello@thelazystudio.com

# Optional. Defaults to Resend's shared onboarding sender, which works straight
# away but is more likely to land in spam. Switch to an address on your own
# verified domain once its DNS records are set up in Resend.
CONTACT_FROM="The Lazy Studio <hello@thelazystudio.com>"
