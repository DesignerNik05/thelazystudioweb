# Contact form delivery.
#
# These are VITE_* variables, so they are baked into the built JS and are
# PUBLIC. That is fine here — a form endpoint URL and its public access key are
# visible in any submitted request anyway. Never put a private API key in a
# VITE_* variable.
#
# Copy to .env.production.local before running `npm run build`. .env* is gitignored.

# Formspree:   https://formspree.io  -> https://formspree.io/f/xxxxxxxx
# Web3Forms:   https://web3forms.com -> https://api.web3forms.com/submit
VITE_CONTACT_ENDPOINT=

# Web3Forms only — its public access key. Leave blank for Formspree.
VITE_CONTACT_ACCESS_KEY=
